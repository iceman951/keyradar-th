{
  "name": "keyradar-th",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite dev",
    "dev:api": "wrangler dev --port 8787",
    "dev": "node scripts/run-dev.mjs",
    "build:web": "vite build",
    "build": "vite build",
    "preview": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:d1": "node scripts/test-d1.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:api": "node scripts/run-e2e-api.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply keyradar-th-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply keyradar-th-prod --remote",
    "db:seed:local": "node scripts/seed-d1.mjs --local",
    "db:seed:remote": "node scripts/seed-d1.mjs --remote",
    "db:studio": "drizzle-kit studio",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.2.0",
    "@unocss/preset-wind3": "^66.7.5",
    "@unocss/svelte-scoped": "^66.7.5",
    "drizzle-kit": "0.31.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "elysia": "2.0.0-beta.4",
    "exact-mirror": "^1.2.4",
    "openapi-types": "^12.1.3",
    "typebox": "^1.3.13"
  }
}
