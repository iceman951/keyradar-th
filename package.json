{
  "name": "keyradar-th",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vite build && node scripts/run-e2e.mjs",
    "dev:worker": "vite build && wrangler dev",
    "cf-typegen": "wrangler types",
    "check:worker": "tsc -p worker/tsconfig.json --noEmit",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^24.3.0",
    "@unocss/preset-wind3": "^66.4.2",
    "@unocss/svelte-scoped": "^66.4.2",
    "jsdom": "^26.1.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "unocss": "^66.4.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  }
}
