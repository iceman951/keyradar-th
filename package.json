{
  "name": "keyradar-th",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite dev",
    "dev:api": "wrangler dev --port 8787",
    "dev": "node scripts/run-dev.mjs",
    "build:web": "vite build",
    "build": "vite build",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:d1": "node scripts/test-d1.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:api": "node scripts/run-e2e-api.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply keyradar-th-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply keyradar-th-prod --remote",
    "db:seed:local": "node scripts/seed-d1.mjs --local",
    "db:seed:remote": "node scripts/seed-d1.mjs --remote",
    "db:studio": "drizzle-kit studio",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^24.3.0",
    "@unocss/preset-wind3": "^66.4.2",
    "@unocss/svelte-scoped": "^66.4.2",
    "drizzle-kit": "0.31.10",
    "jsdom": "^26.1.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "unocss": "^66.4.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "elysia": "2.0.0-beta.1",
    "exact-mirror": "^1.2.2",
    "openapi-types": "^12.1.3",
    "typebox": "^1.3.10"
  }
}
