{
  "name": "keyradar-th",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vite build && node scripts/run-e2e.mjs",
    "dev:worker": "vite build && wrangler dev",
    "cf-typegen": "wrangler types",
    "check:worker": "tsc -p worker/tsconfig.json --noEmit",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.13.3",
    "@unocss/preset-wind3": "^66.7.5",
    "@unocss/svelte-scoped": "^66.7.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.121.0"
  }
}
