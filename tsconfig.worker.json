{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "worker/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "tests/api/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
